{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        clj-python/libpython-clj {:mvn/version "2.026"}}
 :aliases
 {;; Python owns the HDC substrate; keep the JVM small.
  :jvm {:jvm-opts ["-Xmx1g" "-Xss512m" "--enable-native-access=ALL-UNNAMED"]}
  :run {:main-opts ["-m" "vsc.main"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         ;; the full S1 differential suite takes ~30 min: run it with :test-s1
         :main-opts ["-m" "cognitect.test-runner" "-e" ":slow"]}
  :test-s1 {:extra-paths ["test"]
            :extra-deps {io.github.cognitect-labs/test-runner
                         {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
            :main-opts ["-m" "cognitect.test-runner" "-n" "vsc.metacircular-test"]}}}
