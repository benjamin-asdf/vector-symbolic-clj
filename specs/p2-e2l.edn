;; P2 E2l: the look-alike task of e2l.edn per cleanup backend. A vector of 8
;; is read out of a list next to 15 stored look-alikes (similarity 7/8), or
;; alone (k = 1). The interpreter's cleanups see correlated rows here, the
;; one case where the MHN's iteration can change a winner.
{:name "p2-e2l"
 :workers 2
 :init {:prelude? false}
 :budget {:max-ops 2000000 :max-rows 60000 :seconds 60}
 :grid [[:dim [2048]]
        [:probe-noise [0 0.5 1 1.5 2 2.5 3 4 5]]
        [:seed {:range [0 12]}]
        [:task [:vec-k1 :vec-k16 :list-k16]]
        [:backend [{:memory :codebook}
                   {:memory :mhn :beta 16 :iters 3} {:memory :mhn :beta 64 :iters 3}
                   {:memory :mhn :beta 256 :iters 3}
                   {:memory :mhn :beta 64 :mode :soft} {:memory :mhn :beta 64 :iters 3 :mode :soft}]]]
 :tasks {:vec-k1 {:gen vsc.experiments.tasks/lookalikes :struct :vec :n 8 :k 1}
         :vec-k16 {:gen vsc.experiments.tasks/lookalikes :struct :vec :n 8 :k 16}
         :list-k16 {:gen vsc.experiments.tasks/lookalikes :struct :list :n 8 :k 16}}}
