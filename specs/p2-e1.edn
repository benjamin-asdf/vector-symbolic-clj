;; P2 E1: primitive cleanup per backend, straight on the substrate
;; (resources/vsc/p2.py, probe_trials). A memory of `load` random atoms is
;; probed with one of them plus probe noise σ; the readout y = clean(probe)
;; is correct if its nearest stored row (taken noise-free) is that atom.
;; Snap with 1 step equals the codebook for every β (softmax is monotone),
;; so snap is swept at 3 and 10 steps only.
{:name "p2-e1"
 :workers 2
 :grid [[:dim [1024 2048 4096]]
        [:load [100 1000]]
        [:seed {:range [0 20]}]
        [:probe-noise [0 2 4 6 8 12 16 20 28 36]]
        [:backend [{:memory :codebook} {:memory :linear}
                   {:memory :mhn :beta 1 :iters 3} {:memory :mhn :beta 4 :iters 3}
                   {:memory :mhn :beta 16 :iters 3} {:memory :mhn :beta 64 :iters 3}
                   {:memory :mhn :beta 1 :iters 10} {:memory :mhn :beta 4 :iters 10}
                   {:memory :mhn :beta 16 :iters 10} {:memory :mhn :beta 64 :iters 10}
                   {:memory :mhn :beta 1 :mode :soft} {:memory :mhn :beta 4 :mode :soft}
                   {:memory :mhn :beta 16 :mode :soft} {:memory :mhn :beta 64 :mode :soft}
                   {:memory :mhn :beta 1 :iters 3 :mode :soft} {:memory :mhn :beta 4 :iters 3 :mode :soft}
                   {:memory :mhn :beta 16 :iters 3 :mode :soft} {:memory :mhn :beta 64 :iters 3 :mode :soft}
                   {:memory :mhn :beta 1 :iters 10 :mode :soft} {:memory :mhn :beta 4 :iters 10 :mode :soft}
                   {:memory :mhn :beta 16 :iters 10 :mode :soft} {:memory :mhn :beta 64 :iters 10 :mode :soft}]]]
 :task {:gen vsc.experiments.tasks/p2-probe :trials 20}}
