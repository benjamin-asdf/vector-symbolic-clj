;; P2: β as a collapse knob (W0 §4 reproduced on the hdc.py backend). N
;; atoms in a soft mhn memory; the probe is a superposition of k of them
;; (equal weights, or 1 … 0.4) plus noise of the signal's norm; after
;; `iters` softmax steps the output is fitted on the k items (p2.py,
;; collapse): pr = items surviving, noise = energy outside their span.
;; success = pr ≥ 0.8k and noise < 0.1 ("keeps the items and cleans").
{:name "p2-collapse"
 :workers 2
 :fixed {:dim 2048 :sigma 1.0}
 :grid [[:load [100 1000 10000]]
        [:k [2 4 8]]
        [:weights ["equal" "unequal"]]
        [:seed {:range [0 10]}]
        [:iters [1 3 10]]
        [:beta [1 2 4 8 12 16 24 32 48 64 128 256 1000]]]
 :task {:gen vsc.experiments.tasks/p2-collapse}}
