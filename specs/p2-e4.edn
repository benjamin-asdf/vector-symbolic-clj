;; P2 E4: lesion (as e4c.edn) per cleanup backend, at D = 2048.
{:name "p2-e4"
 :workers 2
 :init {:prelude? false}
 :budget {:max-ops 300000 :max-rows 60000 :seconds 15}
 :grid [[:dim [2048]]
        [:lesion [0 0.01 0.02 0.05 0.1 0.2 0.3 0.5 0.7]]
        [:seed {:range [0 20]}]
        [:task [:list16 :map8 :arith :program]]
        [:backend [{:memory :codebook} {:memory :linear}
                   {:memory :mhn :beta 4 :iters 3} {:memory :mhn :beta 16 :iters 3}
                   {:memory :mhn :beta 16 :iters 10}
                   {:memory :mhn :beta 16 :mode :soft} {:memory :mhn :beta 64 :mode :soft}
                   {:memory :mhn :beta 64 :iters 3 :mode :soft}]]]
 :tasks {:list16 {:gen vsc.experiments.tasks/structure :struct :list :n 16}
         :map8 {:gen vsc.experiments.tasks/structure :struct :map :n 8}
         :arith {:gen vsc.experiments.tasks/structure :struct :arith}
         :program {:gen vsc.experiments.tasks/structure :struct :program}}}
