;; P2 E2: structure round trips (as e2c.edn) per cleanup backend. Snap with
;; one step is the codebook for every β, so snap runs with 3 and 10 steps.
{:name "p2-e2"
 :workers 2
 :init {:prelude? false}
 :budget {:max-ops 2000000 :max-rows 60000 :seconds 30}
 :grid [[:dim [1024 2048]]
        [:probe-noise [0 1 2 3 4 5 6 8]]
        [:seed {:range [0 20]}]
        [:task [:list16 :map8 :set8]]
        [:backend [{:memory :codebook} {:memory :linear}
                   {:memory :mhn :beta 4 :iters 3} {:memory :mhn :beta 16 :iters 3}
                   {:memory :mhn :beta 16 :iters 10}
                   {:memory :mhn :beta 16 :mode :soft} {:memory :mhn :beta 64 :mode :soft}
                   {:memory :mhn :beta 64 :iters 3 :mode :soft}]]]
 :tasks {:list16 {:gen vsc.experiments.tasks/structure :struct :list :n 16}
         :map8 {:gen vsc.experiments.tasks/structure :struct :map :n 8}
         :set8 {:gen vsc.experiments.tasks/structure :struct :set :n 8}}}
